# Copy to .env and fill in.

# Required for the RAG chat endpoint (generation step).
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini

# These match docker-compose service hostnames; only change for local
# (non-docker) runs of the backend.
DATABASE_URL=postgresql+psycopg2://wrapped:wrapped@localhost:5432/wrapped
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
